<UserControl x:Class="DeskSpaceOS.Service.Controls.SpaceControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             MouseEnter="UserControl_MouseEnter"
             MouseLeave="UserControl_MouseLeave"
             d:DesignHeight="200" d:DesignWidth="300">

    <Grid>
        <!-- Background border - click-through -->
        <Border x:Name="BackgroundBorder"
                Background="#401A1A1A"
                BorderBrush="#60FFFFFF"
                BorderThickness="1"
                CornerRadius="8"
                IsHitTestVisible="False"/>

        <!-- Drop-target highlight overlay (hidden by default) -->
        <Border x:Name="DropHighlightBorder"
                Background="#3000A0FF"
                BorderBrush="#A000A0FF"
                BorderThickness="2"
                CornerRadius="8"
                IsHitTestVisible="False"
                Visibility="Collapsed"/>

        <!-- Header with tabs - interactive -->
        <Border x:Name="HeaderBorder" Height="32" VerticalAlignment="Top"
                Background="#80000000"
                CornerRadius="8,8,0,0"
                MouseLeftButtonDown="Header_MouseLeftButtonDown">
            <Border.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Rename Tab" Click="MenuItem_Rename_Click" />
                    <MenuItem Header="Add Tab" Click="MenuItem_AddTab_Click" />
                    <MenuItem Header="Roll Up / Expand" Click="MenuItem_RollUp_Click" />
                    <Separator/>
                    <MenuItem Header="Background Color">
                        <MenuItem Header="Dark" Click="MenuItem_BgDark_Click" />
                        <MenuItem Header="Light" Click="MenuItem_BgLight_Click" />
                        <MenuItem Header="Blue" Click="MenuItem_BgBlue_Click" />
                        <MenuItem Header="Green" Click="MenuItem_BgGreen_Click" />
                        <MenuItem Header="Purple" Click="MenuItem_BgPurple_Click" />
                    </MenuItem>
                    <MenuItem Header="Transparency">
                        <MenuItem Header="25%" Click="MenuItem_Trans25_Click" />
                        <MenuItem Header="50%" Click="MenuItem_Trans50_Click" />
                        <MenuItem Header="75%" Click="MenuItem_Trans75_Click" />
                    </MenuItem>
                    <Separator/>
                    <MenuItem Header="Sort Icons">
                        <MenuItem Header="By Name" Click="MenuItem_SortByName_Click" />
                        <MenuItem Header="Auto-Arrange" Click="MenuItem_AutoArrange_Click" />
                    </MenuItem>
                    <Separator/>
                    <MenuItem Header="Delete Space" Click="MenuItem_Delete_Click" />
                </ContextMenu>
            </Border.ContextMenu>
            <Grid>
                <!-- Tab strip fills the header -->
                <StackPanel x:Name="TabStrip" Orientation="Horizontal" VerticalAlignment="Center" Margin="4,0,36,0"/>

                <!-- Menu button -->
                <Button Content="&#xE700;"
                        Click="MenuButton_Click"
                        FontFamily="Segoe MDL2 Assets"
                        Background="Transparent"
                        Foreground="White"
                        BorderThickness="0"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Width="32" Height="32"
                        Margin="0,0,4,0">
                    <Button.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Rename Tab" Click="MenuItem_Rename_Click" />
                            <MenuItem Header="Add Tab" Click="MenuItem_AddTab_Click" />
                            <MenuItem Header="Roll Up / Expand" Click="MenuItem_RollUp_Click" />
                            <Separator/>
                            <MenuItem Header="Background Color">
                                <MenuItem Header="Dark" Click="MenuItem_BgDark_Click" />
                                <MenuItem Header="Light" Click="MenuItem_BgLight_Click" />
                                <MenuItem Header="Blue" Click="MenuItem_BgBlue_Click" />
                                <MenuItem Header="Green" Click="MenuItem_BgGreen_Click" />
                                <MenuItem Header="Purple" Click="MenuItem_BgPurple_Click" />
                            </MenuItem>
                            <MenuItem Header="Transparency">
                                <MenuItem Header="25%" Click="MenuItem_Trans25_Click" />
                                <MenuItem Header="50%" Click="MenuItem_Trans50_Click" />
                                <MenuItem Header="75%" Click="MenuItem_Trans75_Click" />
                            </MenuItem>
                            <Separator/>
                            <MenuItem Header="Sort Icons">
                                <MenuItem Header="By Name" Click="MenuItem_SortByName_Click" />
                                <MenuItem Header="Auto-Arrange" Click="MenuItem_AutoArrange_Click" />
                            </MenuItem>
                            <Separator/>
                            <MenuItem Header="Delete Space" Click="MenuItem_Delete_Click" />
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>
            </Grid>
        </Border>

        <!-- Scroll thumb for icon overflow -->
        <Rectangle x:Name="ScrollThumb" Width="6" Fill="#60FFFFFF" 
                   HorizontalAlignment="Right" VerticalAlignment="Top" 
                   Margin="0,34,2,0" RadiusX="3" RadiusY="3" 
                   Visibility="Collapsed" IsHitTestVisible="False"/>

        <!-- Resize grip - bottom right corner -->
        <Thumb x:Name="ResizeGrip"
               Width="16" Height="16"
               HorizontalAlignment="Right"
               VerticalAlignment="Bottom"
               Cursor="SizeNWSE"
               DragDelta="ResizeGrip_DragDelta">
            <Thumb.Template>
                <ControlTemplate>
                    <Grid Background="Transparent">
                        <Path Data="M 0,16 L 16,0 M 5,16 L 16,5 M 10,16 L 16,10"
                              Stroke="#80FFFFFF"
                              StrokeThickness="1"/>
                    </Grid>
                </ControlTemplate>
            </Thumb.Template>
        </Thumb>
    </Grid>
</UserControl>
