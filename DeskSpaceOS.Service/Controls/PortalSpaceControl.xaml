<UserControl x:Class="DeskSpaceOS.Service.Controls.PortalSpaceControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             MouseEnter="UserControl_MouseEnter"
             MouseLeave="UserControl_MouseLeave"
             d:DesignHeight="280" d:DesignWidth="320">

    <UserControl.Resources>
        <!-- Modern thin dark scrollbar -->
        <Style x:Key="PortalScrollBarThumb" TargetType="Thumb">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border Background="#60FFFFFF" CornerRadius="3" Margin="1"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PortalScrollBar" TargetType="ScrollBar">
            <Setter Property="Width" Value="8"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid>
                            <Border Background="#20FFFFFF" CornerRadius="4"/>
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource PortalScrollBarThumb}"/>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PortalScrollViewer" TargetType="ScrollViewer">
            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollViewer">
                        <Grid>
                            <ScrollContentPresenter/>
                            <ScrollBar x:Name="PART_VerticalScrollBar"
                                       HorizontalAlignment="Right"
                                       Orientation="Vertical"
                                       Style="{StaticResource PortalScrollBar}"
                                       Maximum="{TemplateBinding ScrollableHeight}"
                                       ViewportSize="{TemplateBinding ViewportHeight}"
                                       Value="{TemplateBinding VerticalOffset}"
                                       Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <!-- Background -->
        <Border x:Name="BackgroundBorder"
                Background="#60003050"
                BorderBrush="#60FFFFFF"
                BorderThickness="1"
                CornerRadius="8"
                IsHitTestVisible="False"/>

        <!-- Header with tabs -->
        <Border x:Name="HeaderBorder" Height="32" VerticalAlignment="Top"
                Background="#80000000"
                CornerRadius="8,8,0,0">
            <Border.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="View">
                        <MenuItem x:Name="MenuViewIcons" Header="Icons" Click="MenuItem_ViewIcons_Click" IsCheckable="True" IsChecked="True"/>
                        <MenuItem x:Name="MenuViewDetails" Header="Details" Click="MenuItem_ViewDetails_Click" IsCheckable="True"/>
                    </MenuItem>
                    <Separator/>
                    <MenuItem Header="Columns">
                        <MenuItem x:Name="MenuColName" Header="Name" IsCheckable="True" IsChecked="True" Click="MenuItem_ToggleColumn_Click" Tag="Name"/>
                        <MenuItem x:Name="MenuColDate" Header="Date Modified" IsCheckable="True" IsChecked="True" Click="MenuItem_ToggleColumn_Click" Tag="Date"/>
                        <MenuItem x:Name="MenuColSize" Header="Size" IsCheckable="True" IsChecked="True" Click="MenuItem_ToggleColumn_Click" Tag="Size"/>
                    </MenuItem>
                    <Separator/>
                    <MenuItem Header="Sort By">
                        <MenuItem x:Name="MenuSortName" Header="Name" Click="MenuItem_Sort_Click" Tag="Name" IsCheckable="True" IsChecked="True"/>
                        <MenuItem x:Name="MenuSortDate" Header="Date Modified" Click="MenuItem_Sort_Click" Tag="Date" IsCheckable="True"/>
                        <MenuItem x:Name="MenuSortSize" Header="Size" Click="MenuItem_Sort_Click" Tag="Size" IsCheckable="True"/>
                        <Separator/>
                        <MenuItem x:Name="MenuSortAsc" Header="Ascending" Click="MenuItem_SortDirection_Click" Tag="Asc" IsCheckable="True" IsChecked="True"/>
                        <MenuItem x:Name="MenuSortDesc" Header="Descending" Click="MenuItem_SortDirection_Click" Tag="Desc" IsCheckable="True"/>
                    </MenuItem>
                    <Separator/>
                    <MenuItem Header="Background Color">
                        <MenuItem x:Name="MenuBgDark" Header="Dark" Click="MenuItem_BgDark_Click"/>
                        <MenuItem x:Name="MenuBgLight" Header="Light" Click="MenuItem_BgLight_Click"/>
                        <MenuItem x:Name="MenuBgBlue" Header="Blue" Click="MenuItem_BgBlue_Click"/>
                        <MenuItem x:Name="MenuBgGreen" Header="Green" Click="MenuItem_BgGreen_Click"/>
                        <MenuItem x:Name="MenuBgPurple" Header="Purple" Click="MenuItem_BgPurple_Click"/>
                    </MenuItem>
                    <MenuItem Header="Transparency">
                        <MenuItem x:Name="MenuTrans25" Header="25%" Click="MenuItem_Trans25_Click"/>
                        <MenuItem x:Name="MenuTrans50" Header="50%" Click="MenuItem_Trans50_Click"/>
                        <MenuItem x:Name="MenuTrans75" Header="75%" Click="MenuItem_Trans75_Click"/>
                    </MenuItem>
                    <Separator/>
                    <MenuItem Header="Rename Tab" Click="MenuItem_Rename_Click"/>
                    <MenuItem Header="Add Tab" Click="MenuItem_AddTab_Click"/>
                    <MenuItem Header="Roll Up / Expand" Click="MenuItem_RollUp_Click"/>
                    <MenuItem x:Name="MenuEnableNavigation" Header="Enable Navigation"
                              IsCheckable="True" Click="MenuItem_EnableNavigation_Click"/>
                    <MenuItem x:Name="MenuGoHome" Header="Go Home" Click="MenuItem_GoHome_Click"/>
                    <MenuItem x:Name="MenuGoUp" Header="Go Up One Level" Click="MenuItem_GoUp_Click"/>
                    <MenuItem Header="Open Folder" Click="MenuItem_OpenFolder_Click"/>
                    <MenuItem Header="Refresh" Click="MenuItem_Refresh_Click"/>
                </ContextMenu>
            </Border.ContextMenu>
            <Grid>
                <!-- Tab strip fills the header -->
                <StackPanel x:Name="TabStrip" Orientation="Horizontal" VerticalAlignment="Center" Margin="4,0,70,0"/>

                <!-- File count badge -->
                <TextBlock x:Name="CountBadge"
                           Text="0 items"
                           Foreground="#88FFFFFF"
                           FontSize="11"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"
                           Margin="0,0,38,0"/>

                <!-- Menu button -->
                <Button Content="&#xE700;"
                        Click="MenuButton_Click"
                        FontFamily="Segoe MDL2 Assets"
                        Background="Transparent"
                        Foreground="White"
                        BorderThickness="0"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Width="32" Height="32"
                        Margin="0,0,4,0"/>
            </Grid>
        </Border>

        <!-- Content area -->
        <Grid Margin="0,32,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Breadcrumb row (visible only when navigation is enabled and not at home) -->
            <Border x:Name="BreadcrumbBar" Grid.Row="0" Height="22"
                    Background="#40000000" Visibility="Collapsed">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Width="22" Cursor="Hand"
                            MouseLeftButtonDown="Breadcrumb_Home_Click">
                        <TextBlock Text="&#xE80F;" FontFamily="Segoe MDL2 Assets"
                                   Foreground="#CCFFFFFF" FontSize="12"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <Border Grid.Column="1" Width="22" Cursor="Hand"
                            MouseLeftButtonDown="Breadcrumb_Up_Click">
                        <TextBlock Text="&#xE72B;" FontFamily="Segoe MDL2 Assets"
                                   Foreground="#CCFFFFFF" FontSize="12"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock x:Name="BreadcrumbPath" Grid.Column="2"
                               Foreground="#AAFFFFFF" FontSize="10"
                               TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center"
                               Margin="8,0,4,0"/>
                </Grid>
            </Border>

            <!-- Icons view -->
            <ScrollViewer x:Name="IconsScrollViewer" Grid.Row="1" Margin="4,2,4,4"
                          Style="{StaticResource PortalScrollViewer}">
                <WrapPanel x:Name="FileItemsPanel" Orientation="Horizontal" />
            </ScrollViewer>

            <!-- Details view -->
            <Grid x:Name="DetailsView" Grid.Row="1" Visibility="Collapsed">
                <!-- Column headers -->
                <Border Height="24" VerticalAlignment="Top"
                        Background="#40000000">
                    <Grid x:Name="ColumnHeaderGrid">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition x:Name="ColDefName" Width="*"/>
                            <ColumnDefinition x:Name="ColDefDate" Width="110"/>
                            <ColumnDefinition x:Name="ColDefSize" Width="70"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" BorderBrush="#30FFFFFF" BorderThickness="0,0,1,0" Cursor="Hand"
                                MouseLeftButtonDown="ColumnHeader_Click" Tag="Name">
                            <StackPanel Orientation="Horizontal" Margin="6,0,0,0" VerticalAlignment="Center">
                                <TextBlock x:Name="HeaderName" Text="Name" Foreground="#CCFFFFFF" FontSize="11" FontWeight="SemiBold"/>
                                <TextBlock x:Name="HeaderNameSort" Text="" Foreground="#88FFFFFF" FontSize="9" Margin="4,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="1" BorderBrush="#30FFFFFF" BorderThickness="0,0,1,0" Cursor="Hand"
                                MouseLeftButtonDown="ColumnHeader_Click" Tag="Date">
                            <StackPanel Orientation="Horizontal" Margin="6,0,0,0" VerticalAlignment="Center">
                                <TextBlock x:Name="HeaderDate" Text="Date Modified" Foreground="#CCFFFFFF" FontSize="11" FontWeight="SemiBold"/>
                                <TextBlock x:Name="HeaderDateSort" Text="" Foreground="#88FFFFFF" FontSize="9" Margin="4,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="2" Cursor="Hand"
                                MouseLeftButtonDown="ColumnHeader_Click" Tag="Size">
                            <StackPanel Orientation="Horizontal" Margin="6,0,0,0" VerticalAlignment="Center">
                                <TextBlock x:Name="HeaderSize" Text="Size" Foreground="#CCFFFFFF" FontSize="11" FontWeight="SemiBold"/>
                                <TextBlock x:Name="HeaderSizeSort" Text="" Foreground="#88FFFFFF" FontSize="9" Margin="4,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <!-- File rows -->
                <ScrollViewer x:Name="DetailsScrollViewer" Margin="0,24,0,4"
                              Style="{StaticResource PortalScrollViewer}">
                    <StackPanel x:Name="DetailsItemsPanel"/>
                </ScrollViewer>
            </Grid>
        </Grid>

        <!-- Empty state -->
        <TextBlock x:Name="EmptyLabel"
                   Text="Folder is empty"
                   Foreground="#66FFFFFF"
                   FontSize="12"
                   FontStyle="Italic"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   Visibility="Collapsed"/>

        <!-- Resize grip (visual only; resizing handled by global mouse hook) -->
        <Border x:Name="ResizeGrip"
                Width="16" Height="16"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                IsHitTestVisible="False">
            <Path Data="M 0,16 L 16,0 M 5,16 L 16,5 M 10,16 L 16,10"
                  Stroke="#80FFFFFF" StrokeThickness="1"/>
        </Border>
    </Grid>
</UserControl>
