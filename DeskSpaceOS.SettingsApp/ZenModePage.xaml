<Page
    x:Class="DeskSpaceOS_SettingsApp.ZenModePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Loaded="Page_Loaded">

    <ScrollViewer>
        <StackPanel Spacing="24" Padding="0,0,16,24" MaxWidth="720" HorizontalAlignment="Left">
            <TextBlock Text="Zen Mode" FontSize="24" FontWeight="SemiBold"/>
            <TextBlock Text="When enabled, spaces fade into the wallpaper when the mouse is idle over other windows, keeping the desktop distraction-free. Hover back onto the desktop to bring them back."
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>

            <ToggleSwitch x:Name="ZenModeToggle"
                          Header="Enable Zen Mode"
                          OnContent="Spaces fade when idle"
                          OffContent="Spaces stay visible"
                          Toggled="ZenModeToggle_Toggled"/>

            <StackPanel x:Name="TuningPanel" Spacing="16">
                <NumberBox x:Name="IdleBox"
                           Header="Idle time before fade (seconds)"
                           Minimum="0.1" Maximum="30" SmallChange="0.1" LargeChange="1"
                           SpinButtonPlacementMode="Inline"
                           ValueChanged="AnyValue_Changed"/>

                <NumberBox x:Name="OpacityBox"
                           Header="Faded opacity (0.0 – 1.0)"
                           Minimum="0" Maximum="1" SmallChange="0.05" LargeChange="0.1"
                           SpinButtonPlacementMode="Inline"
                           ValueChanged="AnyValue_Changed"/>
            </StackPanel>
            
            <StackPanel Spacing="8">
                <TextBlock Text="Preview" FontWeight="SemiBold"/>
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border x:Name="PreviewOffCard"
                            Grid.Column="0"
                            BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="8"
                            Background="{ThemeResource LayerFillColorDefaultBrush}">
                        <StackPanel Spacing="8">
                            <Image Source="ms-appx:///Assets/zen_mode_off.png"
                                   AutomationProperties.Name="Desktop with Zen Mode off — spaces stay visible"
                                   Stretch="Uniform" Height="200"/>
                            <TextBlock Text="Off — spaces stay visible"
                                       HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <TextBlock x:Name="PreviewOffActiveLabel" Text="Active" Visibility="Collapsed"
                                       HorizontalAlignment="Center" FontWeight="SemiBold"
                                       Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                        </StackPanel>
                    </Border>

                    <Border x:Name="PreviewOnCard"
                            Grid.Column="1"
                            BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="8"
                            Background="{ThemeResource LayerFillColorDefaultBrush}">
                        <StackPanel Spacing="8">
                            <Image Source="ms-appx:///Assets/zen_mode_on.png"
                                   AutomationProperties.Name="Desktop with Zen Mode on — spaces faded into the wallpaper"
                                   Stretch="Uniform" Height="200"/>
                            <TextBlock Text="On — spaces fade when idle"
                                       HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <TextBlock x:Name="PreviewOnActiveLabel" Text="Active" Visibility="Collapsed"
                                       HorizontalAlignment="Center" FontWeight="SemiBold"
                                       Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>

            <InfoBar x:Name="StatusInfoBar" IsOpen="False" IsClosable="True"/>
        </StackPanel>
    </ScrollViewer>
</Page>