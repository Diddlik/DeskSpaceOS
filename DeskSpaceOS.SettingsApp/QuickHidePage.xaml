<Page
    x:Class="DeskSpaceOS_SettingsApp.QuickHidePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Loaded="Page_Loaded">

    <ScrollViewer>
        <StackPanel Spacing="24" Padding="0,0,16,24" MaxWidth="800" HorizontalAlignment="Left">
            <TextBlock Text="Quick Hide" FontSize="28" FontWeight="SemiBold" />
            <TextBlock Text="Quick Hide lets you instantly hide and show your desktop icons by double-clicking an empty spot on your desktop."
                       TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

            <!-- Dummy Preview Screen -->
            <Border BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Background="{ThemeResource LayerFillColorDefaultBrush}">
                <Grid Height="200" Width="400">
                    <Rectangle Fill="{ThemeResource AccentFillColorDefaultBrush}" Opacity="0.1" />
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="8">
                        <SymbolIcon Symbol="HideBcc" RenderTransformOrigin="0.5,0.5">
                            <SymbolIcon.RenderTransform>
                                <ScaleTransform ScaleX="2" ScaleY="2" />
                            </SymbolIcon.RenderTransform>
                        </SymbolIcon>
                        <TextBlock Text="Double-click desktop to hide/show" FontStyle="Italic" Opacity="0.7" />
                    </StackPanel>
                </Grid>
            </Border>

            <StackPanel Spacing="4">
                <HyperlinkButton Content="How to use" Padding="0" />
                <HyperlinkButton Content="Exclude individual spaces" Padding="0" />
            </StackPanel>

            <StackPanel Spacing="16">
                <TextBlock Text="Settings" FontSize="20" FontWeight="SemiBold" />
                
                <CheckBox x:Name="EnableQuickHideCheckBox" Content="Enabled" Checked="SettingChanged" Unchecked="SettingChanged" />
                
                <StackPanel Spacing="8" Margin="0,8,0,0">
                    <ComboBox x:Name="QuickHideScopeComboBox" Width="400" SelectionChanged="SettingChanged">
                        <ComboBoxItem Content="Hide all desktop icons and space groups" Tag="IconsAndSpaces" />
                        <ComboBoxItem Content="Hide desktop icons only" Tag="OnlyIcons" />
                        <ComboBoxItem Content="Hide space groups only" Tag="OnlySpaces" />
                    </ComboBox>
                </StackPanel>

                <CheckBox x:Name="AutoHideCheckBox" Content="Automatically hide icons when the desktop is not in use" Checked="SettingChanged" Unchecked="SettingChanged" />
                <CheckBox x:Name="AutoShowCheckBox" Content="Automatically show icons when the desktop is in use" Checked="SettingChanged" Unchecked="SettingChanged" />
            </StackPanel>

            <StackPanel Spacing="16">
                <TextBlock Text="Additional options" FontSize="20" FontWeight="SemiBold" />
                <CheckBox x:Name="ShowOnStartCheckBox" Content="Always show icons on startup" Checked="SettingChanged" Unchecked="SettingChanged" />
            </StackPanel>

            <Button x:Name="SaveButton" Content="Save settings" Style="{ThemeResource AccentButtonStyle}" Click="SaveButton_Click" Margin="0,12,0,0" />
            <InfoBar x:Name="StatusInfoBar" IsOpen="False" IsClosable="True" />
        </StackPanel>
    </ScrollViewer>
</Page>
