<Page
    x:Class="DeskSpaceOS_SettingsApp.QuickHidePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Loaded="Page_Loaded">

    <ScrollViewer>
        <StackPanel Spacing="24" Padding="0,0,16,24" MaxWidth="800" HorizontalAlignment="Left">
            <TextBlock x:Uid="QuickHide_Title" FontSize="28" FontWeight="SemiBold" />
            <TextBlock x:Uid="QuickHide_Description"
                       TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

            <!-- Dummy Preview Screen -->
            <Border BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Background="{ThemeResource LayerFillColorDefaultBrush}">
                <Grid Height="200" Width="400">
                    <Rectangle Fill="{ThemeResource AccentFillColorDefaultBrush}" Opacity="0.1" />
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="8">
                        <SymbolIcon Symbol="HideBcc" RenderTransformOrigin="0.5,0.5">
                            <SymbolIcon.RenderTransform>
                                <ScaleTransform ScaleX="2" ScaleY="2" />
                            </SymbolIcon.RenderTransform>
                        </SymbolIcon>
                        <TextBlock x:Uid="QuickHide_PreviewCaption" FontStyle="Italic" Opacity="0.7" />
                    </StackPanel>
                </Grid>
            </Border>

            <StackPanel Spacing="4">
                <HyperlinkButton x:Uid="QuickHide_HowToUse" Padding="0" />
                <HyperlinkButton x:Uid="QuickHide_ExcludeSpaces" Padding="0" />
            </StackPanel>

            <StackPanel Spacing="16">
                <TextBlock x:Uid="QuickHide_SettingsTitle" FontSize="20" FontWeight="SemiBold" />
                
                <CheckBox x:Name="EnableQuickHideCheckBox" x:Uid="QuickHide_Enabled" Checked="SettingChanged" Unchecked="SettingChanged" />
                
                <StackPanel Spacing="8" Margin="0,8,0,0">
                    <ComboBox x:Name="QuickHideScopeComboBox" Width="400" SelectionChanged="SettingChanged">
                        <ComboBoxItem x:Uid="QuickHide_ScopeAll" Tag="IconsAndSpaces" />
                        <ComboBoxItem x:Uid="QuickHide_ScopeIcons" Tag="OnlyIcons" />
                        <ComboBoxItem x:Uid="QuickHide_ScopeSpaces" Tag="OnlySpaces" />
                    </ComboBox>
                </StackPanel>

                <CheckBox x:Name="AutoHideCheckBox" x:Uid="QuickHide_AutoHide" Checked="SettingChanged" Unchecked="SettingChanged" />
                <CheckBox x:Name="AutoShowCheckBox" x:Uid="QuickHide_AutoShow" Checked="SettingChanged" Unchecked="SettingChanged" />
            </StackPanel>

            <StackPanel Spacing="16">
                <TextBlock x:Uid="QuickHide_AdditionalOptions" FontSize="20" FontWeight="SemiBold" />
                <CheckBox x:Name="ShowOnStartCheckBox" x:Uid="QuickHide_ShowOnStart" Checked="SettingChanged" Unchecked="SettingChanged" />
            </StackPanel>

            <Button x:Name="SaveButton" x:Uid="QuickHide_Save" Style="{ThemeResource AccentButtonStyle}" Click="SaveButton_Click" Margin="0,12,0,0" />
            <InfoBar x:Name="StatusInfoBar" IsOpen="False" IsClosable="True" />
        </StackPanel>
    </ScrollViewer>
</Page>
