<Page
    x:Class="DeskSpaceOS_SettingsApp.LayoutPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Loaded="Page_Loaded">

    <ScrollViewer>
        <StackPanel Spacing="24" Padding="0,0,16,24" MaxWidth="720" HorizontalAlignment="Left">
            <TextBlock x:Uid="Layout_Title" FontSize="24" FontWeight="SemiBold"/>
            <TextBlock x:Uid="Layout_Description"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>

            <TextBlock x:Uid="Layout_SnappingTitle" FontSize="16" FontWeight="SemiBold" Margin="0,8,0,0"/>

            <ToggleSwitch x:Name="SnappingToggle"
                          x:Uid="Layout_Snapping"
                          AutomationProperties.AutomationId="SnappingToggle"
                          Toggled="SnappingToggle_Toggled"/>

            <NumberBox x:Name="ThresholdBox"
                       x:Uid="Layout_Threshold"
                       Minimum="1" Maximum="100" SmallChange="1" LargeChange="5"
                       SpinButtonPlacementMode="Inline"
                       ValueChanged="Threshold_Changed"/>

            <InfoBar x:Name="StatusInfoBar" IsOpen="False" IsClosable="True"/>
        </StackPanel>
    </ScrollViewer>
</Page>
