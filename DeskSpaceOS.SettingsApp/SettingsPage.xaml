<Page
    x:Class="DeskSpaceOS_SettingsApp.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Loaded="Page_Loaded">

    <ScrollViewer>
        <StackPanel Spacing="24" Padding="0,0,16,24">
            <TextBlock x:Uid="Settings_PageTitle" FontSize="24" FontWeight="SemiBold" />
            <TextBlock x:Uid="Settings_PageDescription"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

            <!-- Startup -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="16,12">
                <StackPanel Spacing="4">
                    <ToggleSwitch x:Name="StartWithWindowsToggle"
                                  x:Uid="Settings_StartWithWindows"
                                  AutomationProperties.AutomationId="StartWithWindowsToggle"
                                  Toggled="StartWithWindowsToggle_Toggled" />
                    <TextBlock x:Uid="Settings_StartWithWindowsDescription"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <!-- Auto arrange -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="16,12">
                <StackPanel Spacing="4">
                    <ToggleSwitch x:Name="DisableAutoArrangeToggle"
                                  x:Uid="Settings_DisableAutoArrange"
                                  AutomationProperties.AutomationId="DisableAutoArrangeToggle"
                                  Toggled="DisableAutoArrangeToggle_Toggled" />
                    <TextBlock x:Uid="Settings_DisableAutoArrangeDescription"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <!-- Quick Hide -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="16,12">
                <StackPanel Spacing="4">
                    <ToggleSwitch x:Name="EnableQuickHideToggle"
                                  x:Uid="Settings_QuickHide"
                                  AutomationProperties.AutomationId="EnableQuickHideToggle"
                                  Toggled="EnableQuickHideToggle_Toggled" />
                    <TextBlock x:Uid="Settings_QuickHideDescription"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <!-- Language -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="16,12">
                <StackPanel Spacing="8">
                    <ComboBox x:Name="LanguageComboBox"
                              x:Uid="Settings_Language"
                              AutomationProperties.AutomationId="LanguageComboBox"
                              HorizontalAlignment="Stretch"
                              SelectionChanged="LanguageComboBox_SelectionChanged">
                        <ComboBoxItem x:Uid="Settings_SystemDefault" Tag="" />
                        <ComboBoxItem Content="English" Tag="en-US" />
                        <ComboBoxItem Content="Deutsch" Tag="de-DE" />
                        <ComboBoxItem Content="Русский" Tag="ru-RU" />
                        <ComboBoxItem Content="Українська" Tag="uk-UA" />
                    </ComboBox>
                    <TextBlock x:Uid="Settings_LanguageDescription"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               FontSize="12"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <!-- Automatic update check -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="16,12">
                <StackPanel Spacing="4">
                    <ToggleSwitch x:Name="AutoUpdateCheckToggle"
                                  x:Uid="Settings_AutoUpdateCheck"
                                  AutomationProperties.AutomationId="AutoUpdateCheckToggle"
                                  Toggled="AutoUpdateCheckToggle_Toggled" />
                    <TextBlock x:Uid="Settings_AutoUpdateCheckDescription"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <InfoBar x:Name="StatusInfoBar" IsOpen="False" IsClosable="True" />
        </StackPanel>
    </ScrollViewer>
</Page>
