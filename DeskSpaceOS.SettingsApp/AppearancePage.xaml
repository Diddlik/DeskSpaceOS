<Page
    x:Class="DeskSpaceOS_SettingsApp.AppearancePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Loaded="Page_Loaded">

    <ScrollViewer>
        <StackPanel Spacing="24" Padding="0,0,16,24">
            <TextBlock x:Uid="Appearance_Title" FontSize="24" FontWeight="SemiBold" />
            <TextBlock x:Uid="Appearance_Description"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />

            <!-- Preview -->
            <StackPanel Spacing="8">
                <TextBlock x:Uid="Appearance_Preview" FontSize="14" FontWeight="SemiBold" />
                <Border x:Name="PreviewBorder"
                        Width="300" Height="160" HorizontalAlignment="Left"
                        CornerRadius="8"
                        BorderBrush="#60FFFFFF" BorderThickness="1">
                    <Grid>
                        <Border x:Name="PreviewHeader" Height="32" VerticalAlignment="Top"
                                Background="#80000000" CornerRadius="8,8,0,0">
                            <TextBlock x:Uid="Appearance_NewSpace" Foreground="White"
                                       FontFamily="Segoe UI Variable, Segoe UI"
                                       FontSize="14" FontWeight="SemiBold"
                                       VerticalAlignment="Center" Margin="12,0,0,0" />
                        </Border>
                    </Grid>
                </Border>
            </StackPanel>

            <!-- Default color -->
            <StackPanel Spacing="8">
                <TextBlock x:Uid="Appearance_DefaultColor" FontSize="14" FontWeight="SemiBold" />
                <ColorPicker x:Name="DefaultColorPicker"
                             IsAlphaEnabled="True"
                             IsColorSpectrumVisible="True"
                             IsColorChannelTextInputVisible="True"
                             IsHexInputVisible="True"
                             ColorChanged="DefaultColorPicker_ColorChanged" />
            </StackPanel>

            <!-- Save -->
            <Button x:Uid="Appearance_Save" Style="{ThemeResource AccentButtonStyle}" Click="SaveButton_Click" />
            <InfoBar x:Name="StatusInfoBar" IsOpen="False" IsClosable="True" />
        </StackPanel>
    </ScrollViewer>
</Page>
