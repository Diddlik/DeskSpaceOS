<UserControl
    x:Class="DeskSpaceOS_SettingsApp.FolderPortalDialogContent"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <StackPanel Width="460" Spacing="10" Padding="0,0,0,8">
        <TextBox
            x:Name="TitleBox"
            Header="Portal Name"
            PlaceholderText="e.g. Downloads" />

        <StackPanel Spacing="4">
            <TextBlock Text="Folder Path" FontSize="14" />
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="0" />
                    <ColumnDefinition Width="104" />
                </Grid.ColumnDefinitions>

                <TextBox
                    x:Name="PathBox"
                    Grid.Column="0"
                    PlaceholderText="C:\Users\You\Downloads"
                    HorizontalAlignment="Stretch"
                    MinWidth="0" />

                <Button
                    x:Name="BrowseButton"
                    Grid.Column="1"
                    Content="Browse..."
                    Width="104"
                    Click="BrowseButton_Click" />
            </Grid>
        </StackPanel>

        <ComboBox
            x:Name="ViewModeCombo"
            Header="View Mode"
            HorizontalAlignment="Stretch"
            SelectedIndex="0">
            <ComboBoxItem Content="Icons" />
            <ComboBoxItem Content="Details" />
        </ComboBox>

        <ComboBox
            x:Name="SortCombo"
            Header="Sort By"
            HorizontalAlignment="Stretch"
            SelectedIndex="0">
            <ComboBoxItem Content="Name" />
            <ComboBoxItem Content="Date Modified" />
            <ComboBoxItem Content="Size" />
        </ComboBox>

        <ComboBox
            x:Name="SortDirCombo"
            Header="Sort Direction"
            HorizontalAlignment="Stretch"
            SelectedIndex="0">
            <ComboBoxItem Content="Ascending" />
            <ComboBoxItem Content="Descending" />
        </ComboBox>

        <ToggleSwitch
            x:Name="EnableNavSwitch"
            Header="Enable Navigation"
            OffContent="Clicks open folders in Explorer"
            OnContent="Clicks navigate inside the portal" />

        <TextBlock
            Text="Visible Columns (Details view)"
            FontSize="13"
            FontWeight="SemiBold"
            Margin="0,2,0,0" />

        <StackPanel Orientation="Horizontal" Spacing="20">
            <CheckBox Content="Name" IsChecked="True" IsEnabled="False" />
            <CheckBox x:Name="ShowDateCheck" Content="Date Modified" IsChecked="True" />
            <CheckBox x:Name="ShowSizeCheck" Content="Size" IsChecked="True" />
        </StackPanel>
    </StackPanel>
</UserControl>
