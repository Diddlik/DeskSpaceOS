<Page
    x:Class="DeskSpaceOS_SettingsApp.TabsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Loaded="Page_Loaded">

    <ScrollViewer>
        <StackPanel Spacing="24" Padding="0,0,16,24" MaxWidth="720" HorizontalAlignment="Left">
            <TextBlock x:Uid="Tabs_Title" FontSize="24" FontWeight="SemiBold"/>
            <TextBlock x:Uid="Tabs_Description"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       TextWrapping="Wrap"/>

            <ComboBox
                x:Name="TabStyleComboBox"
                x:Uid="Tabs_Style"
                Width="320"
                AutomationProperties.AutomationId="TabStyleComboBox"
                SelectionChanged="TabStyleComboBox_SelectionChanged">
                <ComboBoxItem x:Uid="Tabs_Menu" Tag="Menu"/>
                <ComboBoxItem x:Uid="Tabs_Flat" Tag="Flat"/>
                <ComboBoxItem x:Uid="Tabs_Segmented" Tag="Segmented"/>
                <ComboBoxItem x:Uid="Tabs_Rounded" Tag="Rounded"/>
            </ComboBox>

            <InfoBar x:Name="StatusInfoBar" IsOpen="False" IsClosable="True"/>
        </StackPanel>
    </ScrollViewer>
</Page>
