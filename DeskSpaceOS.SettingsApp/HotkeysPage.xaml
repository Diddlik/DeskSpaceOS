<Page
    x:Class="DeskSpaceOS_SettingsApp.HotkeysPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Loaded="Page_Loaded">

    <ScrollViewer>
        <StackPanel Spacing="24" Padding="0,0,16,24">
            <TextBlock x:Uid="Hotkeys_Title" FontSize="24" FontWeight="SemiBold" />
            <TextBlock x:Uid="Hotkeys_Description"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />

            <!-- Peek Mode -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="16,12">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="2">
                        <TextBlock x:Uid="Hotkeys_PeekTitle" FontWeight="SemiBold" />
                        <TextBlock x:Uid="Hotkeys_PeekDescription"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" />
                    </StackPanel>
                    <TextBox x:Name="PeekHotkeyBox" x:Uid="Hotkeys_PeekPlaceholder" Grid.Column="1" Width="160" />
                </Grid>
            </Border>

            <!-- Distraction Free -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="16,12">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="2">
                        <TextBlock x:Uid="Hotkeys_DistractionFreeTitle" FontWeight="SemiBold" />
                        <TextBlock x:Uid="Hotkeys_DistractionFreeDescription"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" />
                    </StackPanel>
                    <TextBox x:Name="DistractionFreeHotkeyBox" x:Uid="Hotkeys_DistractionFreePlaceholder" Grid.Column="1" Width="160" />
                </Grid>
            </Border>

            <!-- New Space -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="16,12">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="2">
                        <TextBlock x:Uid="Hotkeys_NewSpaceTitle" FontWeight="SemiBold" />
                        <TextBlock x:Uid="Hotkeys_NewSpaceDescription"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" />
                    </StackPanel>
                    <TextBox x:Name="NewSpaceHotkeyBox" x:Uid="Hotkeys_NewSpacePlaceholder" Grid.Column="1" Width="160" />
                </Grid>
            </Border>

            <Button x:Uid="Hotkeys_Save" Style="{ThemeResource AccentButtonStyle}" Click="SaveButton_Click" />
            <InfoBar x:Name="StatusInfoBar" IsOpen="False" IsClosable="True" />
        </StackPanel>
    </ScrollViewer>
</Page>
