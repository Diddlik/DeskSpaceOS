<Page
    x:Class="DeskSpaceOS_SettingsApp.PeekPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Loaded="Page_Loaded">

    <ScrollViewer>
        <StackPanel Spacing="24" Padding="0,0,16,24" MaxWidth="720" HorizontalAlignment="Left">
            <TextBlock Text="Peek" FontSize="24" FontWeight="SemiBold"/>
            <TextBlock Text="Temporarily bring spaces and folder portals above active windows."
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       TextWrapping="Wrap"/>

            <ToggleSwitch
                x:Name="EnablePeekToggle"
                Header="Enable Peek"
                OnContent="Peek hotkey is active"
                OffContent="Peek hotkey is disabled"
                AutomationProperties.Name="Enable Peek"
                AutomationProperties.AutomationId="EnablePeekToggle"
                Toggled="EnablePeekToggle_Toggled"/>

            <TextBox
                x:Name="PeekHotkeyBox"
                Header="Peek hotkey"
                Width="240"
                PlaceholderText="e.g. Win+Space"
                AutomationProperties.Name="Peek hotkey"
                AutomationProperties.AutomationId="PeekHotkeyBox"
                TextChanged="PeekHotkeyBox_TextChanged"/>

            <InfoBar x:Name="StatusInfoBar" IsOpen="False" IsClosable="True"/>
        </StackPanel>
    </ScrollViewer>
</Page>
