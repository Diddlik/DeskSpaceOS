<Page
    x:Class="DeskSpaceOS_SettingsApp.PeekPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Loaded="Page_Loaded">

    <ScrollViewer>
        <StackPanel Spacing="24" Padding="0,0,16,24" MaxWidth="720" HorizontalAlignment="Left">
            <TextBlock x:Uid="Peek_Title" FontSize="24" FontWeight="SemiBold"/>
            <TextBlock x:Uid="Peek_Description"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       TextWrapping="Wrap"/>

            <ToggleSwitch
                x:Name="EnablePeekToggle"
                x:Uid="Peek_Enable"
                AutomationProperties.AutomationId="EnablePeekToggle"
                Toggled="EnablePeekToggle_Toggled"/>

            <TextBox
                x:Name="PeekHotkeyBox"
                x:Uid="Peek_Hotkey"
                Width="240"
                AutomationProperties.AutomationId="PeekHotkeyBox"
                TextChanged="PeekHotkeyBox_TextChanged"/>

            <InfoBar x:Name="StatusInfoBar" IsOpen="False" IsClosable="True"/>
        </StackPanel>
    </ScrollViewer>
</Page>
