<Page
    x:Class="DeskSpaceOS_SettingsApp.RollUpPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Loaded="Page_Loaded">

    <ScrollViewer>
        <StackPanel Spacing="24" Padding="0,0,16,24" MaxWidth="720" HorizontalAlignment="Left">
            <TextBlock x:Uid="RollUp_Title" FontSize="24" FontWeight="SemiBold"/>
            <TextBlock x:Uid="RollUp_Description"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       TextWrapping="Wrap"/>

            <ToggleSwitch
                x:Name="EnableRollUpToggle"
                x:Uid="RollUp_Enable"
                AutomationProperties.AutomationId="EnableRollUpToggle"
                Toggled="EnableRollUpToggle_Toggled"/>

            <InfoBar x:Name="StatusInfoBar" IsOpen="False" IsClosable="True"/>
        </StackPanel>
    </ScrollViewer>
</Page>
